<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- TUKI 1.0 uses only bundled content and local storage. Debug/profile
         keep INTERNET for Flutter tooling; release deliberately removes all
         network-state permissions contributed by plugins. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
</manifest>
